# Gemini (optional — server only; never expose to the browser)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public site origin (INFRA-003 / INFRA-004). Production example: https://www.example.com
APP_URL="http://localhost:3000"

# Extra browser origins allowed to call the API with cookies (comma-separated).
# CORS_ORIGINS="https://staging.example.com"

# MongoDB Atlas — required (app + Hostinger deployment)
MONGODB_URI_ATLAS="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
# Use a separate DB name for staging (INFRA-005), e.g. db_liquid_staging
MONGODB_DB="db_liquid"

# Local dev API port (Vite proxies /api here)
API_PORT=3001

# Global API rate limit (RL-001). Defaults: 120 requests / 60s per IP.
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=120

# Per-route limits (RL-002)
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# SIGNUP_RATE_LIMIT_MAX=3
# SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
# BID_RATE_LIMIT_MAX=10
# BID_RATE_LIMIT_WINDOW_MS=60000

# How often to mark expired auctions closed (BID-009). Default 60000.
# AUCTION_CLOSE_INTERVAL_MS=60000

# JWT signing secret — required in production (httpOnly session cookie)
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# Optional: private KYC/doc storage (SEC-011 / PERF-002). Without these, files go to data/private-uploads/ locally.
# S3_BUCKET="your-bucket"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"  # Cloudflare R2; omit for AWS
# S3_REGION="auto"
# PERF-002 — allow browser CSP to load images/videos from R2/S3/custom CDN host(s), comma-separated:
# IMAGE_CDN_ORIGINS="https://images.yourdomain.com,https://pub-xxxxx.r2.dev"

# After Cloudflare orange-cloud is live (RL-003), reject direct origin hits:
# REQUIRE_CLOUDFLARE=true

# INFRA-001 — force HTTPS redirects (default on when NODE_ENV=production). Set false to disable.
# FORCE_HTTPS=true

# HSTS is enabled when NODE_ENV=production. Set to disable on HTTPS staging:
# DISABLE_HSTS=true

# MON-001 — Sentry error monitoring (optional). Create two projects: React + Express.
# Frontend DSN is public (bundled into Vite); backend DSN stays server-only.
# VITE_SENTRY_DSN="https://xxxx@oNNNN.ingest.us.sentry.io/NNNN"   # db-liquid-web
# SENTRY_DSN="https://yyyy@oNNNN.ingest.us.sentry.io/NNNN"         # db-liquid-api

# MON-002 — structured log level (default: debug locally, info in production)
# LOG_LEVEL=info

# Hostinger / cloud sets PORT automatically — do not need to set locally
